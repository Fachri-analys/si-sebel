# WhatsApp Configuration
# Nomor WhatsApp untuk bot (format: 628xxxxxxxxxx tanpa +)
WHATSAPP_PHONE_NUMBER=
PHONE_HASH_KEY=replace-with-a-random-secret

# Bot Configuration
BOT_NAME=Si Sebel
BOT_RESPONSE_DELAY=3

# Database Configuration
DATABASE_PATH=sisebel.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/sisebel.log

# Development/Production Mode
ENVIRONMENT=development

# Redis Configuration (Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=3600  # Cache time-to-live in seconds (1 hour)
ENABLE_CACHE=true

# Load Balancing Configuration
MAX_INSTANCES=1  # Number of bot instances (for future scaling)
MAX_CONNECTIONS=50  # Max concurrent connections per instance
MAX_REQUESTS=100  # Max requests per time window (rate limiting)
RATE_LIMIT_WINDOW=60  # Rate limit time window in seconds

# Security Configuration
SECURITY_MODE=strict  # strict or permissive
ENABLE_SECURITY_LOGGING=true
ENABLE_AUDIT_LOGGING=true
MAX_MESSAGE_LENGTH=4096  # WhatsApp limit
MAX_LOG_LENGTH=500  # Maximum log entry length